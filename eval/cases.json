{
  "about": "Evaluation set for the tutor. Expected answers were verified independently with SymPy. 'expect.values' are acceptable final values (order-free); 'expect.antiderivative_of' is the integrand: the answer must differentiate back to it; 'expect.decline' means the safe behaviour is to NOT give an answer; 'allow_decline' means declining is acceptable but a wrong answer is not.",
  "cases": [
    {"id": "arith-percent", "category": "arithmetic", "input": {"text": "What is 25% of 40?"}, "expect": {"values": ["10"]}},
    {"id": "arith-fractions", "category": "arithmetic", "input": {"text": "3/4 + 1/8"}, "expect": {"values": ["7/8"]}},
    {"id": "arith-order", "category": "arithmetic", "input": {"text": "2 * (6 + 4) - 3^2"}, "expect": {"values": ["11"]}},
    {"id": "arith-percent-change", "category": "arithmetic", "input": {"text": "A price rises from 80 to 100. What is the percentage increase?"}, "expect": {"values": ["25"]}},
    {"id": "arith-compound-interest", "category": "arithmetic", "input": {"text": "$1000 is invested at 5% interest compounded yearly. How much is there after 2 years?"}, "expect": {"values": ["1102.5"]}},
    {"id": "arith-mean", "category": "statistics", "input": {"text": "What is the mean of 4, 8, 15, 16, 23, 42?"}, "expect": {"values": ["18"]}},

    {"id": "alg-linear", "category": "algebra", "input": {"text": "5x - 2 = 3x + 8"}, "expect": {"values": ["5"]}},
    {"id": "alg-quadratic", "category": "algebra", "input": {"text": "x^2 - 5x + 6 = 0"}, "expect": {"values": ["2", "3"]}},
    {"id": "alg-quadratic-complex", "category": "algebra", "input": {"text": "x^2 + 2x + 5 = 0"}, "expect": {"values": ["-1+2*I", "-1-2*I"]}},
    {"id": "alg-inequality", "category": "algebra", "input": {"text": "-3x <= 9"}, "expect": {"text": ["x >= -3"]}},
    {"id": "alg-system", "category": "algebra", "input": {"text": "x + y = 10; x - y = 2"}, "expect": {"values": ["6", "4"]}},
    {"id": "alg-log", "category": "algebra", "input": {"text": "Solve log base 2 of x = 5"}, "expect": {"values": ["32"]}},
    {"id": "alg-trig-equation", "category": "algebra", "input": {"text": "Solve sin(x) = 1/2 for x between 0 and pi/2"}, "expect": {"values": ["pi/6"]}},
    {"id": "alg-sequence", "category": "algebra", "input": {"text": "What is the 10th term of the arithmetic sequence 3, 7, 11, ...?"}, "expect": {"values": ["39"]}},
    {"id": "alg-series-sum", "category": "algebra", "input": {"text": "What is the sum of the first 100 positive integers?"}, "expect": {"values": ["5050"]}},
    {"id": "alg-given-sum-product", "category": "algebra", "input": {"text": "If x + y = 5 and xy = 6, find x^2 + y^2"}, "expect": {"values": ["13"]}},
    {"id": "alg-given-reciprocal", "category": "algebra", "input": {"text": "If x + 1/x = 3, find x^2 + 1/x^2"}, "expect": {"values": ["7"]}},
    {"id": "alg-given-pq", "category": "algebra", "input": {"text": "If p(x+y)^2 = 5 and q(x-y)^2 = 3, find the simplified value of p^2(x+y)^2 + 4pqxy - q^2(x-y)^2"}, "expect": {"values": ["2*p + 2*q"]}},

    {"id": "word-fruit", "category": "word problems", "input": {"text": "Apples cost $2 and cherries $3. I bought 9 fruits for $23. How many apples did I buy?"}, "expect": {"values": ["4"]}},
    {"id": "word-ages", "category": "word problems", "input": {"text": "Maria is 3 times as old as her son. In 12 years she will be twice as old as him. How old is Maria now?"}, "expect": {"values": ["36"]}},
    {"id": "word-two-numbers", "category": "word problems", "input": {"text": "Two numbers add up to 30 and their difference is 4. What is the bigger number?"}, "expect": {"values": ["17"]}},
    {"id": "word-speed", "category": "word problems", "input": {"text": "A train travels 300 km in 4 hours. What is its average speed in km per hour?"}, "expect": {"values": ["75"]}},
    {"id": "word-discount", "category": "word problems", "input": {"text": "A shirt costs $40 and is discounted by 15%. What is the sale price?"}, "expect": {"values": ["34"]}},
    {"id": "word-consecutive", "category": "word problems", "input": {"text": "The sum of three consecutive integers is 72. What is the largest?"}, "expect": {"values": ["25"]}},
    {"id": "word-rectangle", "category": "word problems", "input": {"text": "A rectangle's length is 3 more than its width and its perimeter is 26. What is its area?"}, "expect": {"values": ["40"]}},
    {"id": "word-coins", "category": "word problems", "input": {"text": "I have 20 coins, all dimes and quarters, worth $3.50 in total. How many quarters do I have?"}, "expect": {"values": ["10"]}},
    {"id": "word-pythagoras", "category": "geometry", "input": {"text": "A right triangle has legs 6 and 8. How long is the hypotenuse?"}, "expect": {"values": ["10"]}},

    {"id": "count-choose", "category": "counting & probability", "input": {"text": "10 choose 3"}, "expect": {"values": ["120"]}},
    {"id": "count-probability", "category": "counting & probability", "input": {"text": "What is the probability of getting exactly two heads in three fair coin flips?"}, "expect": {"values": ["3/8"]}},
    {"id": "nt-modular", "category": "number theory", "input": {"text": "What is the remainder when 2^100 is divided by 7?"}, "expect": {"values": ["2"]}},

    {"id": "cx-multiply", "category": "complex numbers", "input": {"text": "(2 + 3i)(1 - i)"}, "expect": {"values": ["5+I"]}},
    {"id": "cx-divide", "category": "complex numbers", "input": {"text": "(1 + 2i) / (3 - i)"}, "expect": {"values": ["1/10+7*I/10"]}},
    {"id": "mx-det3", "category": "matrices", "input": {"text": "det [[2, 0, 1], [1, 3, 2], [1, 1, 1]]"}, "expect": {"values": ["0"]}},
    {"id": "mx-inverse", "category": "matrices", "input": {"text": "inverse of [[4, 7], [2, 6]]"}, "expect": {"matrix": [["3/5", "-7/10"], ["-1/5", "2/5"]]}},
    {"id": "mx-eigen", "category": "matrices", "input": {"text": "eigenvalues of [[2, 1], [1, 2]]"}, "expect": {"values": ["1", "3"]}},
    {"id": "mx-words", "category": "matrices", "input": {"text": "Find the determinant of the 2 by 2 matrix with first row 3 8 and second row 4 6"}, "expect": {"values": ["-14"]}},

    {"id": "calc-product-rule", "category": "calculus", "input": {"text": "derivative of x^2 sin(x)"}, "expect": {"values": ["x**2*cos(x) + 2*x*sin(x)"]}},
    {"id": "calc-chain-product", "category": "calculus", "input": {"text": "differentiate e^(3x) * cos(2x)"}, "expect": {"values": ["exp(3*x)*(3*cos(2*x) - 2*sin(2*x))"]}},
    {"id": "calc-parts", "category": "calculus", "input": {"text": "integral of x e^x dx"}, "expect": {"antiderivative_of": "x*exp(x)"}},
    {"id": "calc-definite", "category": "calculus", "input": {"text": "integral from 0 to 1 of x^2 dx"}, "expect": {"values": ["1/3"]}},
    {"id": "calc-definite-parts", "category": "calculus", "input": {"text": "integral from 0 to pi of x sin(x) dx"}, "expect": {"values": ["pi"]}},
    {"id": "calc-hard-gemini", "category": "calculus", "difficulty": "hard", "input": {"text": "Evaluate the integral from 0 to pi of 8x / (4cos^2(x) + sin^2(x)) dx"}, "expect": {"values": ["2*pi**2"], "allow_decline": true}},
    {"id": "calc-limit-lhopital", "category": "calculus", "input": {"text": "limit of sin(x)/x as x -> 0"}, "expect": {"values": ["1"]}},
    {"id": "calc-limit-infinity", "category": "calculus", "input": {"text": "limit of (1 + 2/n)^n as n -> infinity"}, "expect": {"values": ["exp(2)"]}},
    {"id": "calc-ode-first", "category": "calculus", "input": {"text": "y' = 2y, y(0) = 3"}, "expect": {"values": ["3*exp(2*x)"]}},
    {"id": "calc-ode-second", "category": "calculus", "input": {"text": "y'' + 4y = 0, y(0) = 1, y'(0) = 0"}, "expect": {"values": ["cos(2*x)"]}},
    {"id": "calc-taylor", "category": "calculus", "input": {"text": "taylor series of e^x"}, "expect": {"values": ["1 + x + x**2/2 + x**3/6 + x**4/24"]}},
    {"id": "cs-big-o", "category": "computer science", "difficulty": "stretch", "input": {"text": "Which grows faster as n gets large: n log n or n^1.5?"}, "expect": {"text": ["n^1.5", "n**1.5", "n^(3/2)"], "allow_decline": true}},

