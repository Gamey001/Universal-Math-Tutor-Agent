# Copy this file to .env (which git ignores) and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-...your-key...

# Optional
# TUTOR_OPENAI_MODEL=gpt-5                # any chat model your key can use (check: python -m tutor.cloud_check)
# TUTOR_OPENAI_REASONING_EFFORT=medium    # low | medium | high ("" for non-reasoning models)
# TUTOR_CLOUD=off                         # force local-only
